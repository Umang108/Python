'''
# Node Class:
class Node:
    def init(self,val):
        self.data = val
        self.left = None
        self.right = None
'''

class Solution:
    def isSumProperty(self, root):
        # code here
        if root is None or (root.left is None and root.right is None):
            return 1
        
        
        sum = 0
        
        if root.left is not None:
           sum += root.left.data
           
        if root.right is not None:
            sum += root.right.data
            
        return 1 if (sum == root.data and self.isSumProperty(root.left) and self.isSumProperty(root.right)) else 0
            
